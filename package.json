{
  "name": "react-router-hono-server",
  "version": "4.0.1",
  "description": "The Vite plugin you need to create a Hono server for your React Router app in less than 10 seconds.",
  "homepage": "https://github.com/rphlmr/react-router-hono-server#readme",
  "bugs": {
    "url": "https://github.com/rphlmr/react-router-hono-server/issues"
  },
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rphlmr/react-router-hono-server.git"
  },
  "bin": {
    "react-router-hono-server": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./node": {
      "import": {
        "types": "./dist/adapters/node.d.ts",
        "import": "./dist/adapters/node.js",
        "default": "./dist/adapters/node.js"
      }
    },
    "./bun": {
      "import": {
        "types": "./dist/adapters/bun.d.ts",
        "import": "./dist/adapters/bun.js",
        "default": "./dist/adapters/bun.js"
      }
    },
    "./cloudflare": {
      "import": {
        "types": "./dist/adapters/cloudflare.d.ts",
        "import": "./dist/adapters/cloudflare.js",
        "default": "./dist/adapters/cloudflare.js"
      }
    },
    "./aws-lambda": {
      "import": {
        "types": "./dist/adapters/aws-lambda.d.ts",
        "import": "./dist/adapters/aws-lambda.js",
        "default": "./dist/adapters/aws-lambda.js"
      }
    },
    "./deno": {
      "import": {
        "types": "./dist/adapters/deno.d.ts",
        "import": "./dist/adapters/deno.js",
        "default": "./dist/adapters/deno.js"
      }
    },
    "./dev": {
      "import": {
        "types": "./dist/dev.d.ts",
        "import": "./dist/dev.js",
        "default": "./dist/dev.js"
      }
    },
    "./middleware": {
      "import": {
        "types": "./dist/middleware.d.ts",
        "import": "./dist/middleware.js",
        "default": "./dist/middleware.js"
      }
    },
    "./http": {
      "import": {
        "types": "./dist/http.d.ts",
        "import": "./dist/http.js",
        "default": "./dist/http.js"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "build:pack": "pnpm test:prepare",
    "build:watch": "pnpm run build -- --watch",
    "changeset": "changeset",
    "changeset:next": "changeset pre enter next",
    "changeset:next:exit": "changeset pre exit",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "clear-all": "rm -rf node_modules pnpm-lock.yaml",
    "prepare": "vp config",
    "prepublishOnly": "pnpm run build",
    "release": "changeset publish",
    "test": "vp test run",
    "test:aws": "pnpm test:prepare && vp test run --project runtime tests/integration/aws",
    "test:bun": "pnpm test:prepare && vp test run --project runtime tests/integration/bun",
    "test:cloudflare": "pnpm test:prepare && vp test run --project runtime tests/integration/cloudflare",
    "test:cov": "vp test run --coverage",
    "test:deno": "pnpm test:prepare && vp test run --project runtime tests/integration/deno",
    "test:node": "pnpm test:prepare && vp test run --project runtime tests/integration/node",
    "test:package": "pnpm test:prepare && pnpm test:package:prepared && vp test run --project package",
    "test:package:prepared": "publint out/test-artifacts/*.tgz && attw out/test-artifacts/*.tgz --profile esm-only",
    "test:prepare": "node tests/prepare.ts",
    "test:suite": "pnpm test:prepare && pnpm test:package:prepared && vp test run",
    "test:unit": "vp test run --project unit",
    "typecheck": "tsc",
    "validate": "vp check",
    "version": "changeset version && vp fmt package.json CHANGELOG.md"
  },
  "dependencies": {
    "@drizzle-team/brocli": "0.12.0",
    "@hono/node-server": "2.1.1",
    "@hono/vite-dev-server": "0.26.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.0",
    "@cloudflare/workers-types": "5.20260814.1",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.3.14",
    "@types/deno": "2.7.0",
    "@types/node": "26.2.0",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "catalog:",
    "hono": "4.13.2",
    "npm-run-all": "4.1.5",
    "publint": "0.3.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vite-plus": "catalog:",
    "ws": "8.21.3"
  },
  "peerDependencies": {
    "@react-router/dev": "^8.3.0",
    "@types/ws": "^8.18.1",
    "hono": "^4.13.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "vite": ">=8.2.1",
    "ws": "^8.21.3"
  },
  "peerDependenciesMeta": {
    "@types/ws": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
